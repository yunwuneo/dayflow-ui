NODE_ENV=production
HOST=0.0.0.0
PORT=4310
PUBLIC_ORIGIN=https://dayflow.example.com
DOMAIN=dayflow.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://dayflow:replace-with-a-long-random-password@db:5432/dayflow
ADMIN_USERNAME=neo
ADMIN_PASSWORD=replace-with-at-least-12-characters
SYNC_TOKEN=replace-with-at-least-32-random-characters
READ_API_TOKEN=replace-with-a-different-32-character-token
STORAGE_DIR=/app/storage
TRUST_PROXY=true
CASDOOR_ORIGIN=https://auth.neo7.cn
CASDOOR_CLIENT_ID=dayflow-ui-local
CASDOOR_CLIENT_SECRET=replace-with-a-long-random-client-secret
CASDOOR_REDIRECT_URI=http://127.0.0.1:4310/api/v1/auth/casdoor/callback

# MCP OAuth is opt-in; copy exact client and redirect details from ChatGPT's UI.
# Missing required values reject startup when enabled. No production secrets here.
MCP_OAUTH_ENABLED=false
MCP_OWNER_USERNAME=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_NAME=
MCP_OAUTH_REDIRECT_URIS=
# Empty = public client (none); configure a separate secret only for a confidential client.
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_ACCESS_TOKEN_SECONDS=3600
MCP_OAUTH_GRANT_SECONDS=2592000
MCP_OAUTH_CODE_SECONDS=120

# Notion public connection (server-only). User sync switches live in the web UI.
NOTION_ENABLED=false
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Generate once: openssl rand -hex 32. Keep stable; back up separately from the DB.
NOTION_ENCRYPTION_KEY=
# Must exactly match PUBLIC_ORIGIN/api/v1/integrations/notion/callback
NOTION_REDIRECT_URI=
# Public, duplicable template URL; also set in Notion Developer portal.
NOTION_TEMPLATE_URL=
