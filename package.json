{
  "name": "dayflow-cloud",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx server/index.ts",
    "dev:background": "node --env-file=.env scripts/start-local.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file=.env --import tsx server/index.ts",
    "test": "node --env-file=.env --import tsx --test tests/server.test.ts",
    "test:ui": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "sync:local": "node --env-file=.env scripts/sync-local.mjs",
    "admin:password": "node --env-file=.env --import tsx scripts/reset-password.ts",
    "setup": "node scripts/setup.mjs",
    "client:build": "bash scripts/build-client.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
